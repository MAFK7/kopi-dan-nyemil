<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ink"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#5E1520"/>
                    <stroke android:width="2dp" android:color="@color/ink"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ink"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cherry"/>
                    <stroke android:width="2dp" android:color="@color/ink"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>