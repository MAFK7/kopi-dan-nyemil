<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cherry">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_beans" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:contentDescription="Logo Kopi dan Nyemil"
            android:src="@drawable/ic_logo" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <View
                android:id="@+id/panelLeft"
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:layout_marginStart="-84dp"
                android:layout_marginTop="150dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_panel_side"
                android:rotation="-8" />

            <View
                android:id="@+id/panelRight"
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginTop="110dp"
                android:layout_marginEnd="-84dp"
                android:layout_marginBottom="72dp"
                android:background="@drawable/bg_panel_side"
                android:rotation="8" />

            <View
                android:id="@+id/panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="40dp"
                android:layout_marginTop="76dp"
                android:layout_marginEnd="40dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_panel"
                android:rotation="-4" />

            <View
                android:id="@+id/shadow"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="-50dp"
                android:background="@drawable/bg_shadow"
                android:scaleY="0.15" />

            <ImageView
                android:id="@+id/imgHero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:contentDescription="Es kopi dan donat"
                android:rotation="-6"
                android:scaleType="fitCenter"
                android:src="@drawable/welcome_hero" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:text="Kopi dan Nyemil"
            android:textColor="@color/paper"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:text="Get a taste of your wish"
            android:textColor="#CCFAF5EC"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_cta"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Start now  →"
            android:textColor="@color/paper"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>