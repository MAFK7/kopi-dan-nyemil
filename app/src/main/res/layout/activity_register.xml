<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cherry">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_beans" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:minHeight="210dp"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:contentDescription="Logo Kopi dan Nyemil"
                android:src="@drawable/ic_logo" />

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_glass_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/paper"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Register"
                    android:textColor="@color/paper"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Daftar dulu, lalu pilih menu favoritmu."
                    android:textColor="#CCFAF5EC"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <ScrollView
            android:id="@+id/sheet"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet"
            android:clipToPadding="true"
            android:fillViewport="true"
            android:paddingTop="28dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    style="@style/AppLabel"
                    android:layout_marginTop="0dp"
                    android:text="Nama lengkap" />

                <EditText
                    android:id="@+id/etFullName"
                    style="@style/AppInput"
                    android:hint="nama lengkap"
                    android:inputType="textPersonName"
                    android:maxLength="30"/>

                <TextView
                    style="@style/AppLabel"
                    android:text="Username" />

                <EditText
                    android:id="@+id/etUsername"
                    style="@style/AppInput"
                    android:hint="username (minimal 3 karakter)"
                    android:inputType="text" />

                <TextView
                    style="@style/AppLabel"
                    android:text="Password" />

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/AppInput"
                    android:hint="password (minimal 6 karakter)"
                    android:inputType="textPassword" />

                <TextView
                    android:id="@+id/btnRegister"
                    style="@style/AppButton"
                    android:layout_marginTop="28dp"
                    android:text="Register" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sudah punya akun? "
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvToLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:text="Login"
                        android:textColor="@color/cherry"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>